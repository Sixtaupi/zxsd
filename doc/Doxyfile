# SPDX-License-Identifier: Apache-2.0

PROJECT_NAME           = mxsd
PROJECT_NUMBER         = 0.14.0
PROJECT_BRIEF          = "Embedded XML Schema validation for C"
OUTPUT_DIRECTORY       = _build_doxygen
OUTPUT_LANGUAGE        = English

INPUT                  = ../include _doxygen
FILE_PATTERNS          = *.h *.dox *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = _doxygen/main.md

OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_XML           = YES
XML_OUTPUT             = xml
GENERATE_LATEX         = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"

MACRO_EXPANSION        = YES
ENABLE_PREPROCESSING   = YES
SKIP_FUNCTION_MACROS   = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = ..
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

