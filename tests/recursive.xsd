<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="Node">
    <xs:sequence>
      <xs:element name="value" type="xs:string"/>
      <xs:element name="child" type="Node" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Left">
    <xs:sequence>
      <xs:element name="right" type="Right" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Right">
    <xs:sequence>
      <xs:element name="left" type="Left" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="GlobalNode">
    <xs:sequence>
      <xs:element name="value" type="xs:string"/>
      <xs:element ref="globalNode" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="node" type="Node"/>
  <xs:element name="left" type="Left"/>
  <xs:element name="globalNode" type="GlobalNode"/>
</xs:schema>
