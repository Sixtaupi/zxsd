  <xs:element name="entities" type="xs:ENTITIES"/>
  <xs:element name="qname" type="xs:QName"/>
  <xs:element name="uri" type="xs:anyURI"/>
  <xs:element name="duration" type="xs:duration"/>
  <xs:element name="date" type="xs:date"/>
